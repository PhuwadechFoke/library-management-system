{
  "crons": [
    {
      "path": "/api/cron/borrow-reminders",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "app/api/cron/borrow-reminders/route.js": {
      "maxDuration": 60
    },
    "app/api/**/*": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
